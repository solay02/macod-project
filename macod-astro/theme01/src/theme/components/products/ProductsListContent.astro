---
// ── STREAMING COMPONENT ──
// Fetches products and categories, renders the full products listing
// Allows parent page to stream this after layout renders
import ProductCard from "@/theme/components/product/ProductCard.astro";
import { Icon } from "astro-icon/components";
import { fetchProductsRaw, fetchCategoriesRaw } from "@/core/api/client";

interface Props {
  currencySymbol: string;
  content: any;
}

const { currencySymbol, content } = Astro.props;

// Fetch products and categories in parallel (this component streams when ready)
const [products, categories] = await Promise.all([
  fetchProductsRaw(),
  fetchCategoriesRaw(),
]);
---

<div class="max-w-6xl mx-auto px-4 sm:px-5 py-8 sm:py-12">
  <!-- Minimal header -->
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-black tracking-tight" style="color: var(--clr-text)">{content.allProductsSection}</h1>
    <p class="text-sm font-bold opacity-60 mt-1" style="color: var(--clr-text-2)">
      {products.length} {content.productCountLabel}
    </p>
  </div>

  <!-- Category filter — minimal pill bar + sort dropdown -->
  {categories.length > 0 && (
    <div class="flex items-center justify-between gap-2 mb-6">
      <div class="flex items-center gap-2 overflow-x-auto scrollbar-hide pb-2 touch-pan-x">
        <a
          href="/products"
          data-astro-prefetch="hover"
          class="shrink-0 px-4 py-2 rounded-full text-sm font-bold transition-all active:scale-95"
          style="background: var(--clr-text); color: white"
        >
          {content.allLabel}
        </a>
        {categories.map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            data-astro-prefetch="hover"
            class="shrink-0 px-4 py-2 rounded-full text-sm font-bold transition-all active:scale-95"
            style="background: var(--clr-surface-alt); color: var(--clr-text)"
          >
            {cat.name}
          </a>
        ))}
      </div>
      <select id="sort-select" class="ez-sort-select shrink-0 border rounded-full px-3 py-2 text-sm font-bold bg-white" style="border-color: var(--clr-border)">
        <option value="featured">مميز</option>
        <option value="price-asc">السعر: من الأقل</option>
        <option value="price-desc">السعر: من الأعلى</option>
      </select>
    </div>
  )}

  {products.length > 0 ? (
    <div class="products-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
      {products.map((p, i) => (
        <ProductCard
          product={p}
          currencySymbol={currencySymbol}
          eager={i < 4}
          content={content}
        />
      ))}
    </div>
  ) : (
    <div class="py-24 text-center">
      <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6" style="background: var(--clr-surface-alt)">
        <Icon name="heroicons:shopping-bag" class="w-8 h-8" style="color: var(--clr-text-2)" />
      </div>
      <h2 class="text-xl font-black mb-2" style="color: var(--clr-text)">{content.emptyStoreTitle}</h2>
      <p class="font-bold" style="color: var(--clr-text-2)">{content.emptyStoreSub}</p>
    </div>
  )}
</div>
