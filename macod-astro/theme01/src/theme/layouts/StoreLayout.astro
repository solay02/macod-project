---
import "@/theme/styles/global.css";
import BaseHead from "@/theme/components/layout/BaseHead.astro";
import Header from "@/theme/components/layout/Header.astro";
import Footer from "@/theme/components/layout/Footer.astro";
import CartDrawer from "@/theme/components/cart/CartDrawer.astro";
import MobileNav from "@/theme/components/layout/MobileNav.astro";
import WhatsAppWidget from "@/theme/components/chat/WhatsAppWidget.astro";
import { showsWidgetOn } from "@/theme/utils/shows-widget-on";
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";
import { DEFAULT_CONFIG } from "@/theme/config/store";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  config?: StoreConfig;
  content?: StoreFrontContent;
  hideMobileNav?: boolean;
  /** Marketing mode (landing pages): no header, no mobile nav, no footer —
   *  the page is images + form + sticky CTA, nothing else. */
  marketing?: boolean;
  /** LCP images (landing page stack top) — preloaded in <head>. */
  preloadImages?: string[];
}

const { title, description, ogImage, noindex, config: c, content, marketing = false, preloadImages } = Astro.props;
const hideMobileNav = marketing || Astro.props.hideMobileNav;
const config = c ?? DEFAULT_CONFIG;

const isRTL = config.lang === "ar";
const pageTitle = title ?? config.metaTitle ?? config.name;
const pageDesc = description ?? config.metaDescription ?? (content?.defaultMetaDescription?.replace("{storeName}", config.name) ?? `Shop from ${config.name}`);
const pageOg = ogImage ?? config.ogImage ?? "";

// Sanitise theme values — never trust DB content as CSS
const HEX = /^#[0-9a-fA-F]{3,8}$/;
const primary = HEX.test(config.primaryColor) ? config.primaryColor : "#7c3aed";
const accent  = HEX.test(config.accentColor)  ? config.accentColor  : "#f59e0b";
const bg      = HEX.test(config.bgColor)      ? config.bgColor      : "#f4f4f7";
const font    = config.fontFamily.replace(/["<>]/g, "");

// Google Fonts — default: Cairo (AR) + Plus Jakarta Sans (EN fallback)
const fontHref = config.fontUrl?.replace(/["<>]/g, "")
  ?? "https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap";

// Custom code injection (MaCod) — merchant-pasted scripts/CSS/HTML.
// Rendered via <Fragment set:html={...} /> at three injection points.
const customCode = (config as any).customCode;
const customHead = customCode?.customHead;
const customBodyOpen = customCode?.customBodyOpen;
const customFooter = customCode?.customFooter;
---

<!doctype html>
<html lang={config.lang} dir={isRTL ? "rtl" : "ltr"}>
  <BaseHead 
    title={pageTitle}
    description={pageDesc}
    ogImage={pageOg}
    noindex={noindex}
    config={config}
    primary={primary}
    accent={accent}
    bg={bg}
    font={font}
    fontHref={fontHref}
    preloadImages={preloadImages}
  />

  {/* Custom code injection — <head> (MaCod) */}
  {customHead && <Fragment set:html={customHead} />}

  <body class:list={[!hideMobileNav && "has-mobile-nav"]}>
    {/* Custom code injection — <body> open (GTM noscript, Hotjar) */}
    {customBodyOpen && <Fragment set:html={customBodyOpen} />}
    <!-- Announcement bar -->
    {!marketing && (config.announcementBar || content?.announcementText) && (
      <div class="store-announce">
        <Icon name="heroicons:truck" class="w-3.5 h-3.5 opacity-80" />
        <span>{config.announcementBar ?? content?.announcementText}</span>
      </div>
    )}

    {!marketing && <Header config={config} content={content} />}

    <main>
      <slot />
    </main>

    {!marketing && <Footer config={config} content={content} />}

    {/* One drawer per page, outside the main flow so its fixed positioning is
        never trapped by a transformed ancestor. Rendered only when the cart is
        on: a merchant who never enabled it ships none of this markup. */}
    {config.cartEnabled && content && (
      <>
        <CartDrawer content={content} currency={config.currencySymbol} />
        {/* Imported for its side effect: the module self-initialises on
            DOMContentLoaded, the same pattern product.ts uses. Calling
            initCart() here as well used to bind every handler twice. */}
        <script>
          import "@/theme/scripts/cart-ui";
        </script>
      </>
    )}

    {/* Moroccan phone validation — runs on every page that renders the
        checkout form. Self-initialises on DOMContentLoaded. */}
    <script>
      import "@/theme/scripts/morocco-phone-validation";
    </script>

    {/* Conversion optimization — exit-intent popup, runs on all pages */}
    <script>
      import "@/theme/scripts/conversion-optimization";
    </script>

    {/* WhatsApp Chat Widget — merchant-configurable contact handoff.
        Rendered only when configured, non-null, and enabled on the current surface. 
        EXCEPTION: On thank-you page, we show an inline button instead of the floating widget. */}
    {config.whatsapp && content && showsWidgetOn(config.whatsapp.surfaces, Astro.url.pathname) && Astro.url.pathname !== "/thank-you" && (
      <>
        <WhatsAppWidget widget={config.whatsapp} content={content} config={config} />
        {/* Imported for side effect: self-initialises on DOM ready */}
        <script>
          import "@/theme/scripts/whatsapp-widget";
        </script>
      </>
    )}

    {!hideMobileNav && <MobileNav config={config} content={content} />}

    {/* Custom code injection — before </body> (chat widgets, custom JS) */}
    {customFooter && <Fragment set:html={customFooter} />}

    {/* Exit-intent popup (conversion optimization) */}
    <div id="exit-intent-popup" class="hidden fixed inset-0 z-[200] items-center justify-center p-4" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px)">
      <div class="relative max-w-sm w-full rounded-3xl p-8 text-center" style="background: var(--clr-surface)">
        <button data-close-popup class="absolute top-3 end-3" style="color: var(--clr-text-2)">
          <Icon name="heroicons:x-mark" class="w-6 h-6" />
        </button>
        <div class="w-16 h-16 mx-auto mb-3 rounded-full flex items-center justify-center" style="background: color-mix(in srgb, var(--clr-accent) 15%, transparent)">
          <Icon name="heroicons:gift" class="w-8 h-8" style="color: var(--clr-accent)" />
        </div>
        <h3 class="text-xl font-black mb-2" style="color: var(--clr-text)">خصم 10% على طلبك الأول!</h3>
        <p class="text-sm mb-4" style="color: var(--clr-text-2)">استخدم الكود التالي عند الطلب:</p>
        <div class="inline-block px-6 py-3 rounded-2xl mb-4 font-black text-lg tracking-wider"
          style="background: var(--clr-surface-alt); color: var(--clr-accent); border: 2px dashed var(--clr-accent)">
          EZZARO10
        </div>
        <p class="text-xs" style="color: var(--clr-text-2)">صالح للطلبات الأولى فقط · الدفع عند الاستلام</p>
      </div>
    </div>
  </body>
</html>
